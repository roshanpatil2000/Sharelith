# Copy to .env and fill in from your Supabase project:
#   Dashboard → Project Settings → API (or the "Connect" button)
# SUPABASE_URL is the Project URL; SUPABASE_ANON_KEY is the anon / publishable
# key (safe to ship in the app — row-level security protects the data).
# Never put the service_role / secret key here.
#
# Rebuild the native app after changing this file (react-native-config bakes
# values in at build time).
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=replace-with-anon-key
