# Copy to .env and fill in. Values come from `npx supabase status`
# (local) or your Supabase project's API settings (hosted).
#
# Simulators reach the host machine at 127.0.0.1 (iOS) and 10.0.2.2 (Android
# emulator); src/lib/env.ts rewrites localhost for Android automatically.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=replace-with-anon-key
