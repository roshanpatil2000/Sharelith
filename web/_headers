# Netlify / Cloudflare Pages equivalent of vercel.json headers.
/*
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  Content-Security-Policy: default-src 'self'; script-src 'unsafe-inline'; style-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'

/auth/*
  Cache-Control: no-store
