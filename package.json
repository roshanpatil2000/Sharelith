{
  "name": "sharelith",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" App.tsx",
    "pods": "cd ios && bundle exec pod install",
    "prepare": "husky",
    "verify": "npm run typecheck && npm run lint && npm test",
    "db:link": "supabase link",
    "db:push": "supabase db push --linked",
    "db:new": "supabase migration new",
    "db:types": "supabase gen types typescript --linked --schema public > src/lib/database.types.ts && prettier --write src/lib/database.types.ts",
    "functions:deploy": "supabase functions deploy --use-api",
    "functions:secrets": "supabase secrets set --env-file supabase/functions/.env",
    "db:restore-profiles": "supabase migration repair --status reverted 20261028165155 --linked && supabase db push --linked --yes"
  },
  "dependencies": {
    "@gorhom/bottom-sheet": "^5.2.14",
    "@hookform/resolvers": "^6.0.2",
    "@react-native/new-app-screen": "0.88.1",
    "@react-navigation/bottom-tabs": "^7.21.0",
    "@react-navigation/native": "^7.5.1",
    "@react-navigation/native-stack": "^7.21.0",
    "@shopify/flash-list": "^2.3.3",
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/query-async-storage-persister": "^5.105.0",
    "@tanstack/react-query": "^5.105.0",
    "@tanstack/react-query-persist-client": "^5.105.0",
    "lucide-react-native": "^1.63.0",
    "react": "19.3.0",
    "react-hook-form": "^7.91.0",
    "react-native": "0.88.1",
    "react-native-biometrics": "^3.0.1",
    "react-native-config": "^1.7.2",
    "react-native-gesture-handler": "^3.4.0",
    "react-native-image-picker": "^8.3.0",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-reanimated": "^4.7.1",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-screens": "^4.30.0",
    "react-native-svg": "^15.16.0",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-worklets": "^0.13.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.88.1",
    "@react-native/eslint-config": "0.88.1",
    "@react-native/jest-preset": "0.88.1",
    "@react-native/metro-config": "0.88.1",
    "@react-native/typescript-config": "0.88.1",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "babel-plugin-module-resolver": "^5.0.3",
    "eslint": "^8.19.0",
    "husky": "^9.1.7",
    "jest": "^29.6.3",
    "lint-staged": "^17.6.0",
    "prettier": "2.8.8",
    "react-test-renderer": "19.3.0",
    "supabase": "^2.122.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js}": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
