{
  "info": {
    "_postman_id": "d39be63e-364a-5ed0-a382-531ce676e59e",
    "name": "Sharelith API",
    "description": "Sharelith's Supabase API: Auth, the database functions (RPC) the app calls, and the edge functions.\n\nSet supabase_url and anon_key (Project Settings → API; the anon/publishable key is public), plus email and password for a test account, then run Auth → Sign in. Requests send the saved access_token.\n\nEverything here acts on whichever project supabase_url points at; with the live project that's real data.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
