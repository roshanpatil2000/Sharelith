  "item": [
    {
      "name": "Auth",
      "description": "Supabase Auth (GoTrue). Sign in saves access_token, refresh_token and user_id to the collection variables.\n\nNote: Sharelith keeps one signed-in device per account. Signing in here doesn't sign the app out by itself; only the app calls claim-session.",
      "item": [
        {
          "name": "Sign up",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "apikey",
                "value": "{{anon_key}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{supabase_url}}/auth/v1/signup",
              "host": [
                "{{supabase_url}}"
              ],
              "path": [
                "auth",
                "v1",
                "signup"
              ]
            },
            "description": "Creates an account. The app sends the same metadata, including Terms consent.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"data\": {\n    \"full_name\": \"Postman Tester\",\n    \"default_currency\": \"INR\",\n    \"timezone\": \"Asia/Kolkata\",\n    \"terms_accepted_at\": \"{{$isoTimestamp}}\",\n    \"terms_version\": \"2026-11-18\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.access_token) {",
                  "  pm.collectionVariables.set('access_token', body.access_token);",
                  "  pm.collectionVariables.set('refresh_token', body.refresh_token);",
                  "  pm.collectionVariables.set('user_id', body.user.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Verify sign-up code",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "apikey",
                "value": "{{anon_key}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{supabase_url}}/auth/v1/verify",
              "host": [
                "{{supabase_url}}"
              ],
              "path": [
                "auth",
                "v1",
                "verify"
              ]
            },
            "description": "With \"Confirm email\" on, Sign up returns no session and emails a 6-digit code. Put the code in the otp variable (current value) and send this: it confirms the email and signs you in, saving access_token, refresh_token and user_id.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"signup\",\n  \"email\": \"{{email}}\",\n  \"token\": \"{{otp}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('confirmed and signed in', () => pm.expect(body.access_token).to.be.a('string'));",
                  "if (body.access_token) {",
                  "  pm.collectionVariables.set('access_token', body.access_token);",
                  "  pm.collectionVariables.set('refresh_token', body.refresh_token);",
                  "  pm.collectionVariables.set('user_id', body.user.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Resend confirmation email",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "apikey",
                "value": "{{anon_key}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{supabase_url}}/auth/v1/resend",
              "host": [
                "{{supabase_url}}"
              ],
              "path": [
                "auth",
                "v1",
                "resend"
              ]
            },
            "description": "Sends a new sign-up confirmation email (code and link). Supabase rate-limits this to about one a minute.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"signup\",\n  \"email\": \"{{email}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Sign in (password)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "apikey",
                "value": "{{anon_key}}"
