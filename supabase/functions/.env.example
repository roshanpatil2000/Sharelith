# Edge Function secrets. Don't commit real values.
# Set them on the hosted project with:
#   npx supabase secrets set --env-file supabase/functions/.env
MAILTRAP_API_TOKEN=replace-with-mailtrap-api-token
MAILTRAP_FROM_EMAIL=no-reply@techbeas.co.in
MAILTRAP_FROM_NAME=Sharelith
# Authentication → Hooks → Send Email Hook → secret (starts with v1,whsec_)
SEND_EMAIL_HOOK_SECRET=v1,whsec_replace-with-hook-secret
